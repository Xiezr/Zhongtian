# .gitignore —— 什么不进版本库，判据见 docs/项目地图.md 第二节「素材拆解」
#
# 总原则：只跟踪「运行期需要的」+ 代码 + 文档 + 工具。
# 运行期 = 双击 index.html 就能玩所需的全部文件，约 37MB。
# 其余 200MB 里的绝大部分是原料，排除。

# ─────────── 原料：非运行期，不可再生，请另用独立介质备份 ───────────
# assets/icons/raw         4 个 / 约 14MB    AI 图集原图（废土批 W-B1/W-B6/W-B7 在用；
#                                           Sep 13 旧图集源 1~4.png 已于 v89.235 清理）
# assets/icons/英雄及头像   38 个 / 约 187MB  英雄头像 AI 素材（待处理 · v89.237 入）
# assets/portraits/_raw    28 个 / 约 41MB   名将 AI 原图 · 已移出工作区（10-07 · 回收站可恢复）
# assets/portraits/pd_src  29 个 / 约 3MB    公版画像（已备未启用）· 已移出（09-15 · 回收站可恢复）
# 合计约 269MB（含英雄头像 187MB · _raw/pd_src 已移出见上）。这些是生成素材的源，不是游戏运行需要的图。
# ⚠️ AI 生成不可复现 —— 本仓库不保护它们，务必单独备份（3-2-1）。
assets/icons/raw/
assets/icons/英雄及头像/
assets/portraits/_raw/
assets/portraits/pd_src/

# v91.30：奇观 3D 原始素材（832MB · 不可再生 · 独立备份）—— 只留优化版 assets/wonders/*.glb
assets/wonders/_raw/

# v91.30：奇观 glb 优化工具的 npm 依赖（61MB·可 npm install 复现）
.workbuddy/tools/gltf/node_modules/

# ─────────── 过程产物 ───────────
# 一次性探针放这里，用完即清（约定见 docs/项目地图.md）
.workbuddy/tmp/
# WorkBuddy 内部自动生成的会话记忆/状态，非项目产物
.workbuddy/memory/

# ─────────── 系统垃圾 ───────────
Thumbs.db
desktop.ini
.DS_Store
*~

# ─────────── 运行期素材（明确保留，勿加进来）───────────
# assets/icons/ui/          91 张，bitmaps.js 注册表就是这个目录的映射
# assets/portraits/pool/    91 张，通用头像池（v90 换代：m 66 / f 25）
# assets/portraits/hero_*.webp  30 张名将回退层 —— v90 起退役（磁盘已清 · git 快照可恢复）

# ─────────── v92.240 精简补丁：WorkBuddy 产物曾把 .git 撑到 1.3G ───────────
# head = 整份项目镜像副本（1.9G，WorkBuddy 运行时重建，无需入库）
.workbuddy/head/
# shots = 工具截图（908 张 / 393M，非源码）
.workbuddy/shots/
# backup = WorkBuddy 自身备份 + 顶层手动备份（冗余，git 历史才是真备份）
.workbuddy/backup/
backup/
# eval_20261016 = 一次性评估脚手架产物（29M，非运行期/非源码）
.workbuddy/eval_20261016/
# 各类日志
*.log

# ─────────── v156.14（2026-10-31 · 本轮工程轮补的）───────────
# 工具产物：实机截图（tools/_shots 31 张 / 6MB）与 preserve 快照库（8.7MB blobs）
# —— 都不是源码，看 git 历史或直接重跑脚本即可；只在本地留。
tools/_shots/
tools/_preserve/
# 并行会话的开发脚手架（不属于本项目运行期，也不该由本轮入库）
tools/auto_dev.js
tools/dev_orchestrator.js
tools/dev_ui_agent.js
tools/preserve.js
tools/probe_save.js
tools/probe_save2.js
tools/probe_ui_feedback.js
# node 依赖（v156.14 起的 lint / 依赖检查是纯 dev，不进运行期）
node_modules/
# Claude Code / 临时探针的散落产物
.claude/
_*.txt

